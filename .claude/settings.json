{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/log-sf.ps1",
            "timeout": 15,
            "async": true,
            "statusMessage": "Anotando en la bitácora..."
          }
        ]
      }
    ]
  }
}
